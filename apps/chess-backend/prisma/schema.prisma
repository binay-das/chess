generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(cuid())

  username     String @unique
  email        String @unique
  passwordHash String

  rating Int @default(1200)

  whiteGames Game[] @relation("WhitePlayer")
  blackGames Game[] @relation("BlackPlayer")
  wonGames   Game[] @relation("Winner")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Game {
  id String @id @default(cuid())

  roomCode String

  whitePlayerId String?
  blackPlayerId String?
  winnerId      String?

  whitePlayer User? @relation("WhitePlayer", fields: [whitePlayerId], references: [id])
  blackPlayer User? @relation("BlackPlayer", fields: [blackPlayerId], references: [id])
  winner      User? @relation("Winner", fields: [winnerId], references: [id])

  status GameStatus @default(WAITING)
  turn   PieceColor @default(WHITE)

  fen String
  pgn String @db.Text

  result GameResult?

  startedAt DateTime?
  endedAt   DateTime?

  moves Move[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roomCode])
  @@index([status])
  @@index([whitePlayerId])
  @@index([blackPlayerId])
  @@index([winnerId])
}

model Move {
  id String @id @default(cuid())

  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  moveNumber Int

  playerColor PieceColor

  fromSquare String
  toSquare   String

  san String

  fenAfterMove String

  createdAt DateTime @default(now())

  @@unique([gameId, moveNumber])
  @@index([gameId])
}

enum PieceColor {
  WHITE
  BLACK
}

enum GameStatus {
  WAITING
  ACTIVE
  FINISHED
  ABANDONED
}

enum GameResult {
  WHITE_WIN
  BLACK_WIN
  DRAW
  RESIGNED
  CHECKMATE
  STALEMATE
  TIMEOUT
  REPETITION
  FIFTY_MOVE
  INSUFFICIENT_MATERIAL
}
